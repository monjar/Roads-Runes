      "objectives": [
        {"type": "VISIT_MULTIPLE_LOCATIONS", "title": "Enter three unexplored regions", "required": true, "count": 3}
      ],
      "narrative": [
        {"title": "Three Shadows on the Map", "description": "Three patches of fog lie within reach. Ride into each and let the light in."},
