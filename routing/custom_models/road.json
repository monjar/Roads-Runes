{
  "priority": [
    {"if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "0"},
    {"else_if": "bike_access == false", "multiply_by": "0"},
    {"else_if": "road_class == PRIMARY", "multiply_by": "0.5"},
    {"else_if": "road_class == SECONDARY", "multiply_by": "0.75"},
    {"else_if": "road_class == CYCLEWAY", "multiply_by": "1.3"},
    {"else_if": "bike_network != MISSING", "multiply_by": "1.2"},
    {"if": "surface == GRAVEL || surface == FINE_GRAVEL || surface == COMPACTED || surface == UNPAVED", "multiply_by": "0.3"},
    {"if": "surface == DIRT || surface == GROUND || surface == GRASS || surface == SAND || surface == MUD", "multiply_by": "0.1"},
    {"if": "road_class == TRACK || road_class == PATH", "multiply_by": "0.2"},
    {"if": "road_class == FOOTWAY || road_class == PEDESTRIAN", "multiply_by": "0.4"},
    {"if": "road_class == STEPS", "multiply_by": "0"}
  ],
  "speed": [
    {"if": "road_class == CYCLEWAY", "limit_to": "24"},
    {"if": "surface == GRAVEL || surface == COMPACTED", "limit_to": "14"},
    {"if": "average_slope >= 6", "multiply_by": "0.75"},
    {"if": "average_slope <= -6", "multiply_by": "1.15"}
  ],
  "distance_influence": 90
}
