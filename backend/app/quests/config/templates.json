{
  "_comment": "Quest templates. distanceKm / newTerritoryKm ranges are scaled by the rider profile. Narrative variants are deterministic fallbacks; an LLM may replace them when llm_narrative is enabled.",
  "templates": [
    {
      "id": "EXPLORER_NEW_TERRITORY",
      "characterClass": "EXPLORER",
      "questType": "EXPLORE_NEW_ROADS",
      "minLevel": 1,
      "weight": 3,
      "objectiveRules": {"newTerritoryKm": [3, 8], "distanceKm": [12, 35]},
      "objectives": [
        {"type": "EXPLORE_NEW_ROADS", "title": "Ride {newTerritoryKm} km of roads you have never ridden", "required": true},
        {"type": "COMPLETE_DISTANCE", "title": "Cover at least {distanceKm} km", "required": false}
      ],
      "narrative": [
        {"title": "Uncharted Lanes", "description": "The map beyond your usual roads is still blank. Fill in {newTerritoryKm} km of it."},
        {"title": "Into the Unknown", "description": "Every road you have never ridden is a line waiting to be drawn. Draw {newTerritoryKm} km today."}
      ]
    },
    {
      "id": "EXPLORER_THREE_REGIONS",
