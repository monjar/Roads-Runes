{
  "priority": [
    {"if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "0"},
    {"else_if": "bike_access == false && mtb_access == false", "multiply_by": "0"},
    {"else_if": "road_class == PRIMARY", "multiply_by": "0.3"},
    {"else_if": "road_class == SECONDARY", "multiply_by": "0.6"},
    {"else_if": "road_class == TRACK", "multiply_by": "1.4"},
    {"else_if": "road_class == PATH && mtb_rating <= 2", "multiply_by": "1.3"},
    {"else_if": "road_class == PATH && mtb_rating > 2", "multiply_by": "0.5"},
    {"else_if": "road_class == BRIDLEWAY", "multiply_by": "1.2"},
    {"else_if": "road_class == CYCLEWAY", "multiply_by": "1.0"},
    {"if": "surface == ASPHALT && road_class != CYCLEWAY", "multiply_by": "0.8"},
    {"if": "road_class == STEPS", "multiply_by": "0"}
  ],
  "speed": [
    {"if": "road_class == TRACK || road_class == PATH || road_class == BRIDLEWAY", "limit_to": "14"},
    {"if": "surface == MUD || surface == SAND", "limit_to": "8"},
    {"if": "average_slope >= 8", "multiply_by": "0.6"},
    {"if": "average_slope <= -8", "multiply_by": "1.0"}
  ],
  "distance_influence": 60
}
