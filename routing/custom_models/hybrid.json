{
  "priority": [
    {"if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "0"},
    {"else_if": "bike_access == false", "multiply_by": "0"},
    {"else_if": "road_class == PRIMARY", "multiply_by": "0.45"},
    {"else_if": "road_class == SECONDARY", "multiply_by": "0.7"},
    {"else_if": "road_class == CYCLEWAY", "multiply_by": "1.3"},
    {"else_if": "bike_network != MISSING", "multiply_by": "1.2"},
    {"else_if": "road_class == RESIDENTIAL || road_class == LIVING_STREET", "multiply_by": "1.1"},
    {"if": "surface == GRAVEL || surface == FINE_GRAVEL || surface == COMPACTED", "multiply_by": "0.8"},
    {"if": "surface == DIRT || surface == GROUND || surface == GRASS || surface == SAND || surface == MUD", "multiply_by": "0.3"},
    {"if": "road_class == TRACK && track_type != GRADE1 && track_type != GRADE2", "multiply_by": "0.4"},
    {"if": "road_class == PATH", "multiply_by": "0.4"},
    {"if": "road_class == STEPS", "multiply_by": "0"}
  ],
  "speed": [
    {"if": "road_class == CYCLEWAY", "limit_to": "20"},
    {"if": "surface == GRAVEL || surface == COMPACTED", "limit_to": "14"},
    {"if": "average_slope >= 6", "multiply_by": "0.7"},
    {"if": "average_slope <= -6", "multiply_by": "1.1"}
  ],
  "distance_influence": 80
}
