ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://rr:rr@localhost:5432/roadsandrunes
REDIS_URL=redis://localhost:6379/0
GRAPHHOPPER_URL=http://localhost:8989
# auto: GraphHopper inside its graph, Valhalla everywhere else (routing/README.md)
ROUTING_ENGINE=auto
VALHALLA_URL=https://valhalla1.openstreetmap.de
VALHALLA_API_KEY=
# Discoveries are imported from OpenStreetMap per area on first use
POI_IMPORT_ENABLED=true
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
JWT_SECRET=dev-only-change-me
APPLE_CLIENT_ID=com.roadsandrunes.app
DEV_AUTH_ENABLED=true
H3_RESOLUTION=9
JOB_QUEUE=inline
# Claude reads a rider's typed route request ("go to the Aragon Tower and 2 pubs
# on the way"). With no key there is no reader, and a typed request is answered
# honestly rather than guessed at — the ride still plans from the rider profile.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=roadsandrunes://strava/callback
OBJECT_STORAGE_URL=
APNS_ENABLED=false
# Comma separated; prefix with ! to disable. e.g. FEATURE_FLAGS=story_quests,!fog_of_war
FEATURE_FLAGS=
